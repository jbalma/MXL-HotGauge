// ---------------------------- Materials ----------------------------
// Generated by HotGauge.thermal.die_stack -- edit the spec, not this file.
// Conductivity is W/(um K) and capacity J/(um^3 K); the SI value is in the comment.

material GAAS :
   thermal conductivity     5.5e-05 ; // 55 W/(m K) -- GaAs, anti-Stokes host
   volumetric heat capacity 1.74e-12 ; // 1.74e+06 J/(m^3 K)

material HEATSINK_METAL :
   thermal conductivity     0.0003 ; // 300 W/(m K) -- sink base; the fins are in the sink model, not here
   volumetric heat capacity 3.376e-12 ; // 3.376e+06 J/(m^3 K)

material SILICON :
   thermal conductivity     0.00012 ; // 120 W/(m K) -- bulk Si at operating temperature
   volumetric heat capacity 1.651e-12 ; // 1.651e+06 J/(m^3 K)

// ---------------------------- Heat sink ----------------------------
// No "spread height / area" line: the solver therefore gives every layer exactly the die
// footprint and no lateral relief. Declaring an overhang here is the open gap -- see
// docs/HANDBOOK.html. The coefficient and ambient below are placeholders that
// render_stack_with_sink() replaces from a CoolingSpecSink.
top heat sink :
   heat transfer coefficient 1.000000e-07 ;
   temperature 303.150000 ;

// ---------------------------- Dimensions ---------------------------
dimensions :
   chip length {flp_width}, width {flp_height} ;
   cell length 50, width 50;

// ---------------------------- Layers -------------------------------
layer SINK_LAYER :
   height 2000 ;
   material HEATSINK_METAL ;

layer MR_LAYER :
   height 30 ;
   material GAAS ;

// ---------------------------- Die ----------------------------------
// Listed top-down. The active layer sits 360 um below the top surface of a 400 um die;
// the mesh is graded finer approaching it, where the gradient is.
die IC :
   layer  100   SILICON ; // 100 um below the top surface
   layer  80    SILICON ; // 180 um below the top surface
   layer  80    SILICON ; // 260 um below the top surface
   layer  60    SILICON ; // 320 um below the top surface
   layer  40    SILICON ; // 360 um below the top surface
   source 20    SILICON ; // 380 um below the top surface
   layer  20    SILICON ; // 400 um below the top surface

// ---------------------------- Stack --------------------------------
stack:
   layer SINK SINK_LAYER ;
   layer MR_PIXELS MR_LAYER ;
   die PROCESSOR_DIE IC floorplan "{flp_file}";

// ---------------------------- Analysis -----------------------------
solver :
{solver_config}

// ---------------------------- Output -------------------------------
output :
   // A die layer like PROCESSOR_DIE selects that die's source layer.
{output_list}
